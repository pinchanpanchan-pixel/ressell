# Copia este archivo a .env.local para desarrollo. En Vercel, configura las mismas variables en
# Project Settings > Environment Variables. Ninguna de estas claves es secreta: la seguridad
# la imponen Supabase Auth y las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Email de la única cuenta autorizada (control adicional en el servidor).
OWNER_EMAIL=tu@email.com
